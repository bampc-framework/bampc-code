<!-- Balance-FR3: the FR3 tilts a plate on its end-effector to balance a free
     6-DOF block, which rests on the plate, not a table. The plate is NOT in
     this XML — models/fr3/ee_plate.xml is attached in Python, and the sensors
     below name the `ee_frame` that attach creates, so a raw XML load will not
     compile. -->

<mujoco model="balance_fr3 scene">

  <!-- Solver options live in Python (configs/numerics/balance_fr3.yaml). -->

  <default>
    <geom contype="1" conaffinity="1" />

    <default class="block">
      <!-- condim=6 activates spin/roll, so the block rolls, not only slides. -->
      <geom friction="0.06 0.001 0.00001"
        solref="0.02 1.0"
        solimp="0.9 0.99 0.001 0.5 2"
        condim="6" />
    </default>

    <default class="goal">
      <geom conaffinity="0" contype="0" rgba="0 1 0 0.15" />
    </default>
  </default>

  <worldbody>
    <camera name="top_view" pos="-0.276 -0.512 0.817"
      xyaxes="0.864 -0.503 0.000 0.404 0.694 0.596" />
    <camera name="main" pos="-0.719 1.218 1.689" xyaxes="-0.801 -0.598 0.000 0.389 -0.521 0.760" />
    <camera name="video" pos="1.017 1.077 1.437" xyaxes="-0.839 0.545 0.000 -0.318 -0.490 0.812"/>


    <!-- Grafted from the chosen shape at build time; the goal is a mocap so
         its pose can ride the plate. -->
    <body name="goal" mocap="true" pos="0.4 0.0 0.55" quat="1 0 0 0">
    </body>

    <body name="block" pos="0.4 0.0 0.55" quat="1 0 0 0" childclass="block">
      <joint name="block" type="free" pos="0 0 0" />
    </body>
  </worldbody>

  <include file="../fr3/fr3_arm.xml" />

  <!-- MUST come after the include: overrides the arm's meshdir. -->
  <compiler angle="radian" meshdir="../fr3/assets" />

  <sensor>
    <framepos name="position" objtype="body" objname="block" reftype="body"
      refname="goal" />
    <framequat name="orientation" objtype="body" objname="block" reftype="body"
      refname="goal" />

    <framepos name="position_world" objtype="body" objname="block" />
    <framepos name="goal_position_world" objtype="body" objname="goal" />
    <framequat name="orientation_world" objtype="body" objname="block" />
    <framequat name="goal_orientation_world" objtype="body" objname="goal" />

    <framezaxis name="ee_zaxis" objtype="body" objname="ee_frame" />
    <framepos name="ee_position_world" objtype="body" objname="ee_frame" />
  </sensor>

  <keyframe>
    <!-- The 7 arm values are the level-plate pose; the block is re-placed
         onto the plate at build time. -->

    <key name="home"
      qpos="0.4 0 0.55 1 0 0 0 1.37403565 -1.40987036 -0.97431012 -2.55119855 2.16326643 1.74726006 2.01985714"
      ctrl="0 0 0 0 0 0 0" />
  </keyframe>

  <statistic center="0.4 0 0.4" extent="1.0" />

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
      width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300"
      height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true"
      texrepeat="5 5" reflectance="0.2" />
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" type="plane" size="0 0 0.0001" material="groundplane"
      contype="0" conaffinity="0" />
  </worldbody>
</mujoco>
